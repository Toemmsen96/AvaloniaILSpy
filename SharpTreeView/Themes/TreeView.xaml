<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ICSharpCode.TreeView">

	<SolidColorBrush x:Key="SharpTreeView.SelectionBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.25" />
	<SolidColorBrush x:Key="SharpTreeView.SelectionInactiveBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
	<SolidColorBrush x:Key="SharpTreeView.HoverBrush" Color="#808080" Opacity="0.14" />

	<ControlTheme x:Key="SharpTreeViewExpanderTheme" TargetType="ToggleButton">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Width" Value="12" />
		<Setter Property="Height" Value="16" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}">
					<Path Name="ChevronPath"
					      Width="5"
					      Height="8"
					      Stretch="Uniform"
					      HorizontalAlignment="Center"
					      VerticalAlignment="Center"
					      Fill="{TemplateBinding Foreground}"
					      Data="M 0 0 L 5 4 L 0 8 Z"
					      RenderTransformOrigin="50%,50%" />
				</Border>
			</ControlTemplate>
		</Setter>
		<Style Selector="^:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Style>
		<Style Selector="^:checked /template/ Path#ChevronPath">
			<Setter Property="RenderTransform" Value="rotate(90deg)" />
		</Style>
	</ControlTheme>

	<ControlTheme x:Key="{x:Type local:InsertMarker}" TargetType="local:InsertMarker">
		<Setter Property="IsHitTestVisible" Value="False" />
		<Setter Property="Height" Value="6" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid>
					<Border VerticalAlignment="Center"
					        Height="2"
					        Background="{DynamicResource SystemAccentColor}" />
					<Path Data="m 0 0 l 3 3 l -3 3"
					      Fill="{DynamicResource SystemAccentColor}"
					      HorizontalAlignment="Left" />
					<Path Data="m 0 0 l -3 3 l 3 3"
					      Fill="{DynamicResource SystemAccentColor}"
					      HorizontalAlignment="Right" />
				</Grid>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="{x:Type local:SharpTreeViewItem}" TargetType="local:SharpTreeViewItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		<Setter Property="Padding" Value="4,0" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="FocusAdorner" Value="{x:Null}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="PART_Border"
				        BorderBrush="Transparent"
				        BorderThickness="1"
				        Background="{TemplateBinding Background}"
				        CornerRadius="4"
				        Margin="4,0"
				        Padding="{TemplateBinding Padding}">
					<local:SharpTreeNodeView Name="nodeView"
					                         Foreground="{TemplateBinding Foreground}"
					                         HorizontalAlignment="Left"
					                         VerticalAlignment="Center" />
				</Border>
			</ControlTemplate>
		</Setter>
		<Style Selector="^:pointerover /template/ Border#PART_Border">
			<Setter Property="Background" Value="{DynamicResource SharpTreeView.HoverBrush}" />
		</Style>
		<Style Selector="^:selected /template/ Border#PART_Border">
			<Setter Property="Background" Value="{DynamicResource SharpTreeView.SelectionInactiveBrush}" />
		</Style>
		<Style Selector="^:selected:focus-within /template/ Border#PART_Border">
			<Setter Property="Background" Value="{DynamicResource SharpTreeView.SelectionBrush}" />
		</Style>
		<Style Selector="^:focus-visible /template/ Border#PART_Border">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="Foreground" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}" />
		</Style>
	</ControlTheme>

	<ControlTheme x:Key="{x:Type local:SharpTreeNodeView}" TargetType="local:SharpTreeNodeView">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid>
					<local:LinesRenderer Name="linesRenderer"
					                     ClipToBounds="True"
					                     IsVisible="{Binding ShowLines, RelativeSource={RelativeSource AncestorType={x:Type local:SharpTreeView}}}" />
					<StackPanel Orientation="Horizontal">
						<Control Name="spacer" />
						<ToggleButton Name="expander"
						              Theme="{StaticResource SharpTreeViewExpanderTheme}"
						              Margin="0 0 3 0"
						              VerticalAlignment="Center" />
						<Border Name="checkBoxContainer"
						        Width="16"
						        Margin="0 0 3 0">
							<CheckBox Name="checkBox"
							          HorizontalAlignment="Center"
							          VerticalAlignment="Center" />
						</Border>
						<StackPanel Orientation="Horizontal"
						            Background="Transparent"
						            ToolTip.Tip="{Binding ToolTip}">
							<ContentPresenter Name="icon"
							                  Width="16"
							                  Height="16"
							                  Margin="2 0 6 0"
							                  VerticalAlignment="Center"
							                  Content="{TemplateBinding Icon}"
							                  Focusable="False">
								<ContentPresenter.ContentTemplate>
									<DataTemplate>
										<Image Source="{Binding}" />
									</DataTemplate>
								</ContentPresenter.ContentTemplate>
							</ContentPresenter>
							<Border Name="textContainer"
							        CornerRadius="2"
							        Background="{TemplateBinding TextBackground}">
								<ContentPresenter Name="textContent"
								                  Margin="0 0 6 0"
								                  VerticalAlignment="Center"
								                  Focusable="False" />
							</Border>
							<Border Name="textEditorContainer" />
						</StackPanel>
					</StackPanel>
				</Grid>
			</ControlTemplate>
		</Setter>
	</ControlTheme>
</ResourceDictionary>

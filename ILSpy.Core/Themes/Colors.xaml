<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Colors used by ILSpy's own chrome. Everything else comes from the Fluent theme. -->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="ILSpy.WindowBackgroundBrush" Color="#F3F3F3" />
			<SolidColorBrush x:Key="ILSpy.PaneBackgroundBrush" Color="#F9F9F9" />
			<SolidColorBrush x:Key="ILSpy.PaneHeaderBackgroundBrush" Color="#EEEEEE" />
			<SolidColorBrush x:Key="ILSpy.DividerBrush" Color="#E0E0E0" />
			<SolidColorBrush x:Key="ILSpy.SecondaryTextBrush" Color="#616161" />
			<SolidColorBrush x:Key="ILSpy.CodeBackgroundBrush" Color="#FFFFFF" />
			<SolidColorBrush x:Key="ILSpy.CodeForegroundBrush" Color="#1F1F1F" />
			<SolidColorBrush x:Key="ILSpy.LineNumberBrush" Color="#8A8A8A" />
			<SolidColorBrush x:Key="ILSpy.OverlayBackgroundBrush" Color="#D0FFFFFF" />
			<SolidColorBrush x:Key="ILSpy.InfoBarBackgroundBrush" Color="#E6F2FB" />
			<SolidColorBrush x:Key="ILSpy.InfoBarBorderBrush" Color="#B7D7F1" />
			<Color x:Key="ILSpy.LocalReferenceColor">#5520B2AA</Color>
			<Color x:Key="ILSpy.LocalDefinitionColor">#5590EE90</Color>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="ILSpy.WindowBackgroundBrush" Color="#202020" />
			<SolidColorBrush x:Key="ILSpy.PaneBackgroundBrush" Color="#252526" />
			<SolidColorBrush x:Key="ILSpy.PaneHeaderBackgroundBrush" Color="#2D2D2D" />
			<SolidColorBrush x:Key="ILSpy.DividerBrush" Color="#3A3A3A" />
			<SolidColorBrush x:Key="ILSpy.SecondaryTextBrush" Color="#A0A0A0" />
			<SolidColorBrush x:Key="ILSpy.CodeBackgroundBrush" Color="#1E1E1E" />
			<SolidColorBrush x:Key="ILSpy.CodeForegroundBrush" Color="#D4D4D4" />
			<SolidColorBrush x:Key="ILSpy.LineNumberBrush" Color="#858585" />
			<SolidColorBrush x:Key="ILSpy.OverlayBackgroundBrush" Color="#C01E1E1E" />
			<SolidColorBrush x:Key="ILSpy.InfoBarBackgroundBrush" Color="#1F3247" />
			<SolidColorBrush x:Key="ILSpy.InfoBarBorderBrush" Color="#2E4C6B" />
			<Color x:Key="ILSpy.LocalReferenceColor">#5520B2AA</Color>
			<Color x:Key="ILSpy.LocalDefinitionColor">#554E9A06</Color>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!-- Fluent's default tab headers are very large -->
	<x:Double x:Key="TabItemHeaderFontSize">15</x:Double>

	<SolidColorBrush x:Key="ILSpy.SelectionBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.25" />
	<SolidColorBrush x:Key="ILSpy.SelectionInactiveBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
	<SolidColorBrush x:Key="ILSpy.HoverBrush" Color="#808080" Opacity="0.14" />
</ResourceDictionary>

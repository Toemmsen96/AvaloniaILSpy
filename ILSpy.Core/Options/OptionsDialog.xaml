<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ICSharpCode.ILSpy.Properties"
        x:Class="ICSharpCode.ILSpy.Options.OptionsDialog"
        Classes="DialogWindow"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        MinWidth="480"
        MinHeight="360"
        Width="720"
        Height="560"
        Title="{x:Static properties:Resources.Options}">
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Classes="dialogFooter">
			<StackPanel Classes="dialogButtons">
				<Button Name="okButton" Classes="accent" IsDefault="True" Content="{x:Static properties:Resources.OK}" />
				<Button Name="cancelButton" IsCancel="True" Content="{x:Static properties:Resources.Cancel}" />
			</StackPanel>
		</Border>
		<TabControl Name="tabControl" Margin="12,4,12,0" />
	</DockPanel>
</Window>

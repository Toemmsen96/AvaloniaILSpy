<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ICSharpCode.ILSpy.Properties"
        x:Class="ICSharpCode.ILSpy.OpenListDialog"
        Title="{x:Static properties:Resources.OpenList}"
        Classes="DialogWindow"
        WindowStartupLocation="CenterOwner"
        MinWidth="480"
        MinHeight="300"
        Width="520"
        Height="400">
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Classes="dialogFooter">
			<DockPanel>
				<StackPanel DockPanel.Dock="Left" Classes="dialogButtons" HorizontalAlignment="Left">
					<Button Name="createButton" Content="{x:Static properties:Resources._Create}" />
					<Button Name="deleteButton" IsEnabled="False" Content="{x:Static properties:Resources.OpenListDialog__Delete}" />
					<Button Name="resetButton" Content="{x:Static properties:Resources._Reset}" />
				</StackPanel>
				<StackPanel Classes="dialogButtons">
					<Button Name="okButton" Classes="accent" IsDefault="True" IsEnabled="False" Content="{x:Static properties:Resources.OpenListDialog__Open}" />
					<Button Name="cancelButton" IsCancel="True" Content="{x:Static properties:Resources.Cancel}" />
				</StackPanel>
			</DockPanel>
		</Border>
		<DockPanel Margin="20,16,20,12">
			<TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{x:Static properties:Resources.SelectList}" />
			<Border BorderBrush="{DynamicResource ILSpy.DividerBrush}" BorderThickness="1" CornerRadius="4">
				<ListBox Name="listView" SelectionMode="Single" Background="Transparent" />
			</Border>
		</DockPanel>
	</DockPanel>
</Window>

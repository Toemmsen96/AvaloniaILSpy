<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ICSharpCode.ILSpy.Properties"
        x:Class="ICSharpCode.ILSpy.CreateListDialog"
        Title="{x:Static properties:Resources.List}"
        Classes="DialogWindow"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        Width="380">
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Classes="dialogFooter">
			<StackPanel Classes="dialogButtons">
				<Button Name="okButton" Classes="accent" IsDefault="True" IsEnabled="False" Click="OKButton_Click" Content="{x:Static properties:Resources.Create}" />
				<Button Name="cancelButton" IsCancel="True" Click="CancelButton_Click" Content="{x:Static properties:Resources.Cancel}" />
			</StackPanel>
		</Border>
		<StackPanel Margin="20,16" Spacing="8">
			<TextBlock Text="{x:Static properties:Resources.EnterListName}" />
			<TextBox Name="ListName" />
		</StackPanel>
	</DockPanel>
</Window>

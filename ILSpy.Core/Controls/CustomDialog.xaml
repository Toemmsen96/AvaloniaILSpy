<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ICSharpCode.ILSpy.Controls.CustomDialog"
        Classes="DialogWindow"
        Title="Message"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        MinWidth="320"
        MaxWidth="640"
        MaxHeight="600">
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Classes="dialogFooter">
			<ItemsControl Name="buttons">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Classes="dialogButtons" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</Border>
		<Grid Margin="20,20,24,20" ColumnDefinitions="Auto,*">
			<PathIcon Name="icon"
			          Width="28"
			          Height="28"
			          Margin="0,0,16,0"
			          VerticalAlignment="Top"
			          IsVisible="False" />
			<ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
				<SelectableTextBlock Name="content" TextWrapping="Wrap" VerticalAlignment="Center" />
			</ScrollViewer>
		</Grid>
	</DockPanel>
</Window>

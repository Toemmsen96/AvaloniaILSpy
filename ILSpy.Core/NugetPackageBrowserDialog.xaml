<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ICSharpCode.ILSpy.Properties"
        x:Class="ICSharpCode.ILSpy.NugetPackageBrowserDialog"
        Title="{x:Static properties:Resources.NugetPackageBrowser}"
        Classes="DialogWindow"
        WindowStartupLocation="CenterOwner"
        MinWidth="320"
        MinHeight="240"
        Height="420"
        Width="720">
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Classes="dialogFooter">
			<StackPanel Classes="dialogButtons">
				<Button Name="okButton" Classes="accent" IsDefault="True" IsEnabled="{Binding HasSelection}" Content="{x:Static properties:Resources.Open}" />
				<Button Name="cancelButton" IsCancel="True" Content="{x:Static properties:Resources.Cancel}" />
			</StackPanel>
		</Border>
		<DockPanel Margin="20,16,20,12">
			<TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{x:Static properties:Resources.SelectAssembliesOpen}" />
			<Border BorderBrush="{DynamicResource ILSpy.DividerBrush}" BorderThickness="1" CornerRadius="4">
				<ListBox ItemsSource="{Binding Package.Entries}" Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>
		</DockPanel>
	</DockPanel>
</Window>

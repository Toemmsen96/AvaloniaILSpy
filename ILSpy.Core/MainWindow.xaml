<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tv="clr-namespace:ICSharpCode.TreeView;assembly=SharpTreeView"
        xmlns:local="clr-namespace:ICSharpCode.ILSpy"
        xmlns:controls="clr-namespace:ICSharpCode.ILSpy.Controls"
        xmlns:properties="clr-namespace:ICSharpCode.ILSpy.Properties"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="ICSharpCode.ILSpy.MainWindow"
        Title="ILSpy"
        Width="1280"
        Height="800"
        MinWidth="480"
        MinHeight="320"
        UseLayoutRounding="True"
        Icon="/Images/ILSpy.png"
        Background="{DynamicResource ILSpy.WindowBackgroundBrush}">
	<NativeMenu.Menu>
		<NativeMenu />
	</NativeMenu.Menu>
	<DockPanel>
		<!-- Main menu: contents are added using MEF -->
		<Menu DockPanel.Dock="Top" Name="mainMenu" KeyboardNavigation.TabNavigation="None">
			<MenuItem Header="{x:Static properties:Resources._File}" />
		</Menu>

		<!-- Toolbar -->
		<Border DockPanel.Dock="Top" Classes="toolbarHost">
			<DockPanel>
				<ComboBox Name="themeComboBox"
				          DockPanel.Dock="Right"
				          Classes="toolbar"
				          Width="110"
				          ToolTip.Tip="Theme" />
				<StackPanel Name="toolBar" Orientation="Horizontal" Spacing="2">
					<!-- 'Navigation' toolbar category is inserted here -->
					<Border Classes="toolbarSeparator" />
					<!-- 'Open' toolbar category is inserted here -->
					<Border Classes="toolbarSeparator" />
					<ToggleButton Classes="toolbar"
					              IsChecked="{Binding FilterSettings.ShowInternalApi}"
					              ToolTip.Tip="{x:Static properties:Resources.Show_internalTypesMembers}">
						<PathIcon Data="{DynamicResource ILSpy.Icon.PrivateInternal}" />
					</ToggleButton>
					<ToggleButton Classes="toolbar"
					              IsChecked="{Binding FilterSettings.ShowAllApi}"
					              ToolTip.Tip="{x:Static properties:Resources.Show_allTypesAndMembers}">
						<PathIcon Data="{DynamicResource ILSpy.Icon.ShowAll}" />
					</ToggleButton>
					<Border Classes="toolbarSeparator" />
					<ComboBox Name="languageComboBox"
					          Classes="toolbar"
					          MinWidth="120"
					          ItemsSource="{x:Static local:Languages.AllLanguages}"
					          SelectedItem="{Binding FilterSettings.Language}"
					          ToolTip.Tip="{x:Static properties:Resources.SelectLanguageDropdownTooltip}" />
					<ComboBox Name="languageVersionComboBox"
					          Classes="toolbar"
					          MinWidth="150"
					          Margin="4,0,0,0"
					          IsVisible="{Binding #languageComboBox.SelectedItem.HasLanguageVersions, FallbackValue=False}"
					          ItemsSource="{Binding #languageComboBox.SelectedItem.LanguageVersions}"
					          SelectedItem="{Binding FilterSettings.LanguageVersion}"
					          ToolTip.Tip="{x:Static properties:Resources.SelectVersionDropdownTooltip}" />
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- Status bar -->
		<Border Name="statusBar" Classes="statusBar" DockPanel.Dock="Bottom" IsVisible="False">
			<TextBlock Name="StatusLabel"
			           HorizontalAlignment="Right"
			           VerticalAlignment="Center"
			           ToolTip.Tip="{x:Static properties:Resources.Status}"
			           Text="{x:Static properties:Resources.StandBy}" />
		</Border>

		<!-- Main grid separating left pane (treeView) from main pane (textEditor) -->
		<Grid Name="mainGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition MinWidth="160" Width="0.3*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition MinWidth="200" Width="0.7*" />
			</Grid.ColumnDefinitions>

			<!-- Left pane: Tree View of assemblies and classes -->
			<Border Classes="pane" BorderThickness="0,0,1,0">
				<tv:SharpTreeView Name="treeView"
				                  Background="Transparent"
				                  BorderThickness="0"
				                  Padding="0,4"
				                  ShowRoot="False"
				                  ShowLines="False"
				                  AllowDropOrder="True"
				                  DragDrop.AllowDrop="True" />
			</Border>

			<GridSplitter Grid.Column="1"
			              Width="4"
			              Margin="-2,0"
			              ResizeDirection="Columns" />

			<!-- Right pane: Text Editor -->
			<Grid Name="rightPane" Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="0" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="0.7*" MinHeight="100" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="0" />
				</Grid.RowDefinitions>

				<Border Name="updatePanel" Classes="infoBar" IsVisible="False">
					<DockPanel>
						<Button Name="updatePanelCloseButton"
						        DockPanel.Dock="Right"
						        Classes="paneCloseButton"
						        ToolTip.Tip="Close">
							<PathIcon Width="10" Height="10" Data="{DynamicResource ILSpy.Icon.Close}" />
						</Button>
						<StackPanel Orientation="Horizontal" Spacing="10">
							<PathIcon Width="16" Height="16"
							          Foreground="{DynamicResource SystemAccentColor}"
							          Data="{DynamicResource ILSpy.Icon.Info}" />
							<TextBlock Name="updatePanelMessage"
							           VerticalAlignment="Center"
							           Text="{x:Static properties:Resources.ILSpyVersionAvailable}" />
							<Button Name="downloadOrCheckUpdateButton"
							        Classes="accent"
							        Content="{x:Static properties:Resources.Download}" />
						</StackPanel>
					</DockPanel>
				</Border>

				<controls:DockedPane Name="topPane" Grid.Row="1" Title="Top" IsVisible="False" />

				<GridSplitter Grid.Row="2"
				              Height="4"
				              ResizeDirection="Rows"
				              IsVisible="{Binding #topPane.IsVisible}" />

				<!-- decompilerTextView is put into the mainPane by code -->
				<ContentControl Name="mainPane" Grid.Row="3" />

				<GridSplitter Grid.Row="4"
				              Height="4"
				              ResizeDirection="Rows"
				              IsVisible="{Binding #bottomPane.IsVisible}" />

				<controls:DockedPane Name="bottomPane" Grid.Row="5" Title="Bottom" IsVisible="False" />
			</Grid>
		</Grid>
	</DockPanel>
</Window>

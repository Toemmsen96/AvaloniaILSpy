<UserControl x:Class="ICSharpCode.ILSpy.Search.SearchPane"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ICSharpCode.ILSpy.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:ICSharpCode.ILSpy.Properties"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="searchPane"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
	<DockPanel>
		<Grid DockPanel.Dock="Top" Margin="8,8,8,6" ColumnDefinitions="*,Auto,Auto">
			<local:SearchBox x:Name="searchBox"
			                 SearchTerm="{Binding #searchPane.SearchTerm, Mode=TwoWay}"
			                 UpdateDelay="0:0:0.15"
			                 ToolTip.Tip="{x:Static properties:Resources.SearchPane_Search}"
			                 Watermark="{x:Static properties:Resources.WatermarkText}" />
			<Label Grid.Column="1"
			       Margin="12,0,6,0"
			       VerticalAlignment="Center"
			       Foreground="{DynamicResource ILSpy.SecondaryTextBrush}"
			       Target="{Binding #searchModeComboBox}"
			       Content="{x:Static properties:Resources._SearchFor}" />
			<ComboBox Grid.Column="2" Name="searchModeComboBox" MinWidth="170" VerticalAlignment="Stretch">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Image Height="16" Width="16" Source="{Binding Image}" />
							<TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
						</StackPanel>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>
		<ProgressBar Name="searchProgressBar"
		             DockPanel.Dock="Top"
		             MinHeight="2"
		             Height="2"
		             Background="Transparent"
		             IsVisible="{Binding $self.IsIndeterminate}" />
		<DataGrid Name="listBox"
		          BorderThickness="0,1,0,0"
		          BorderBrush="{DynamicResource ILSpy.DividerBrush}"
		          SelectionMode="Single"
		          IsReadOnly="True"
		          CanUserReorderColumns="False"
		          CanUserSortColumns="True"
		          CanUserResizeColumns="True"
		          HeadersVisibility="Column"
		          DoubleTapped="ListBox_MouseDoubleClick"
		          ItemsSource="{Binding}">
			<DataGrid.Columns>
				<DataGridTemplateColumn Header="{x:Static properties:Resources.Name}" SortMemberPath="Name" Width="3*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="8,0" Spacing="6" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
								<Image Height="16" Width="16" Source="{Binding Image}" />
								<TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="{x:Static properties:Resources.Location}" SortMemberPath="Location" Width="5*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="8,0" Spacing="6">
								<Image Height="16" Width="16" Source="{Binding LocationImage}" />
								<TextBlock Text="{Binding Location}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="secondary" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
